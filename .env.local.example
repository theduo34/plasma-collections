# Convex deployment URL — printed by `bunx convex dev` on first run, then written here automatically.
NEXT_PUBLIC_CONVEX_URL=

# Which Convex deployment this project points at (dev:xxx or prod:xxx) — set automatically by the Convex CLI.
CONVEX_DEPLOYMENT=

# Convex Auth session signing secret. Server-only, never exposed to the client. Generate with `bunx auth secret` (see @convex-dev/auth docs).
AUTH_SECRET=

# Secret path segment for the admin login page — server-only, never NEXT_PUBLIC_.
# The login form only renders at /<ADMIN_LOGIN_TOKEN>/login; every other path 404s,
# including plain /login. Generate a UUID, e.g. `node -e "console.log(crypto.randomUUID())"`.
ADMIN_LOGIN_TOKEN=

# WhatsApp business number, with country code, digits only, no leading + (e.g. 233XXXXXXXXX). Used to build the wa.me order link.
NEXT_PUBLIC_WA_NUMBER=

# Public base URL of this app, e.g. http://localhost:3000 in dev.
NEXT_PUBLIC_APP_URL=

# Passphrase the client-side localStorage helper (lib/local-storage.ts) derives its
# AES-GCM key from. Necessarily NEXT_PUBLIC_ (it ships in the browser bundle) — this
# only obfuscates localStorage contents against casual inspection, it is not a
# substitute for server-side auth. Generate with `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
# Rotating it invalidates every previously-stored value.
NEXT_PUBLIC_LOCAL_STORAGE_SALT=

# Resend API key — only needed if/when transactional email is added. Not used in the MVP.
RESEND_API_KEY=
